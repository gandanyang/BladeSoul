; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="ONIBLADE 鬼刃"
config/description="和风 3D 剑戟动作游戏（弹开/拼刀/一闪；参考《只狼》《鬼武者》）"
run/main_scene="res://scenes/levels/Dojo.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://src/Core/EventBus.cs"
AudioDirector="*res://src/Audio/AudioDirector.cs"
DebugOverlay="*res://src/UI/DebugOverlay.cs"
CombatVfxDirector="*res://src/Vfx/CombatVfxDirector.cs"
DialogueBox="*res://src/Dialogue/DialogueBox.cs"
Hud="*res://src/UI/Hud.cs"

[dotnet]

project/assembly_name="Oniblade"

