{
  "_note": "序章第一幕的师父台词（T47）。**一字不改照抄 docs/03 §4.0 的分幕脚本。** 纪律同 03 §2.7：短句、不讲道理、师徒关系靠剑术习惯建立而不是靠台词。不要温情对白，不要「剑乃心之器」这一类。",
  "sets": [
    {
      "id": "act1_lesson_1",
      "summary": "第一子段「收」——教学：移动 / 视角 / 跳跃。玄斎只说不做。",
      "tone": "chitchat",
      "lines": [
        { "speaker": "玄斎", "text": "收。" },
        { "speaker": "丛云", "text": "已经收了。" },
        { "speaker": "玄斎", "text": "刀收了，心还没收。" },
        { "speaker": "玄斎", "text": "这回像样。" }
      ]
    },
    {
      "id": "act1_lesson_2",
      "summary": "第二子段「为什么不拔刀」——教学：轻攻击（三连）＋ 收刀。",
      "tone": "chitchat",
      "lines": [
        { "speaker": "玄斎", "text": "今天不练了。" },
        { "speaker": "丛云", "text": "为什么？" },
        { "speaker": "玄斎", "text": "因为你想赢。" },
        { "speaker": "丛云", "text": "练剑不就是为了赢吗？" },
        { "speaker": "玄斎", "text": "不是。" },
        { "speaker": "玄斎", "text": "是为了有一天，不用赢。" }
      ]
    },
    {
      "id": "act1_lesson_3",
      "summary": "第三子段「玄斎唯一一次出刀」——教学：重攻击（蓄力斩）。他那一刀就是演示。",
      "tone": "chitchat",
      "lines": [
        { "speaker": "玄斎", "text": "看好了。" },
        { "speaker": "玄斎", "text": "刀要压住。" },
        { "speaker": "玄斎", "text": "压不住，就不叫重。" }
      ]
    }
  ]
}
